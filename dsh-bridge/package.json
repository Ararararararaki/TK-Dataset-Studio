{
  "name": "dsh-tk-annotate-bridge",
  "version": "0.2.2",
  "private": true,
  "description": "DSH plugin: loopback HTTP bridge that serves TK Dataset Studio annotations through DSH's own LLM service — one request, no session, no conversation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
