{
  "name": "tk-dataset-studio",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first WD14, API and native DSH dataset annotation desktop",
  "author": "TK Dataset Studio contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "package:dir": "npm run build && electron-builder --dir --win --x64",
    "package": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.23",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.tk.datasetstudio",
    "productName": "TK Dataset Studio",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!Lib/site-packages/**"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "backend/requirements.lock.txt",
        "to": "requirements.lock.txt"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "TK-Dataset-Studio-${version}-Windows-x64.exe"
    }
  }
}
